# ============================================================
#  Synthetic Survey Response Generator — Environment Config
# ============================================================

# ── LLM Provider (Groq — free tier) ─────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=something

# ── Model Selection ──────────────────────────────────────────
# Free Groq models: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768
MODEL_NAME=llama3-8b-8192

# ── Generation Settings ──────────────────────────────────────
N=200
MAX_CONCURRENT_CALLS=10
COHERENCE_THRESHOLD=0.6
MAX_RETRIES=3

# ── Output Settings ──────────────────────────────────────────
OUTPUT_DIR=outputs
EXPORT_FORMAT=both          # csv | json | both

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
